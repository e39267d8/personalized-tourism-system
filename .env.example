# Copy this file to .env.local for local development.
# Do not commit real API keys.

# PostgreSQL
TOURISM_DB_CONN=host=127.0.0.1 port=5433 dbname=tourism_system user=postgres

# DeepSeek / LLM
TOURISM_LLM_API_KEY=replace-with-your-deepseek-key
TOURISM_LLM_BASE_URL=https://api.deepseek.com
TOURISM_LLM_MODEL=deepseek-chat

# AMap Web Service
# The backend has a demo default key, but production/demo machines should set their own key here.
AMAP_WEB_SERVICE_KEY=replace-with-your-amap-web-service-key

# Kling image generation
KLING_ACCESS_KEY=replace-with-your-kling-access-key
KLING_SECRET_KEY=replace-with-your-kling-secret-key
KLING_IMAGE_GENERATE_URL=https://api-beijing.klingai.com/v1/images/generations
KLING_IMAGE_MODEL=kling-v1
KLING_IMAGE_POLL_COUNT=8
KLING_IMAGE_POLL_DELAY_MS=1800
