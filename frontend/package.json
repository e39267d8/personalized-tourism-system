{
  "name": "personalized-tourism-frontend",
  "version": "1.0.0",
  "description": "个性化旅游系统前端 - Vue 3 + Tailwind CSS",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/vite-dev.mjs",
    "build": "vite build",
    "preview": "node scripts/vite-preview.mjs",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix",
    "test:auth": "node scripts/run-auth-tests.mjs",
    "test:api": "vitest run src/tests/tourismApi.test.js",
    "test:contract": "node scripts/check-api-contract.mjs",
    "test": "npm run test:auth && npm run test:api && npm run test:contract"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "leaflet": "^1.9.4",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.12",
    "vitest": "^1.2.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "tourism",
    "vuejs",
    "map",
    "travel"
  ],
  "author": "yhm, zby, lxd",
  "license": "MIT"
}
